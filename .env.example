# --- target model (OpenAI-compatible). No key = MOCK mode (works offline for testing) ---
# Free options: Groq (https://console.groq.com), Cerebras, SambaNova, or a local Ollama endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- guard engine ---
# Leave GUARDIAN_URL empty to use the built-in heuristic guard (recommended for public MVP).
# Set it to call the REAL AltaySec Guardian /v1/scan (read-only client; never modifies Guardian).
GUARDIAN_URL=
GUARDIAN_API_KEY=

# --- ops ---
ADMIN_TOKEN=change-me-for-export
RATE_PER_MIN=15
ARENA_DB=/data/arena.db
